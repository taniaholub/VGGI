// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;     // dS/du, нове
attribute vec2 texCoord;    // текстурні координати, нове

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat3 NormalMatrix;

varying vec3 vPos;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTex;

void main() {
    vec4 p = ModelViewMatrix * vec4(vertex, 1.0);
    vPos = p.xyz;
    vNormal = NormalMatrix * normal;
    vTangent = NormalMatrix * tangent;   // у системі ока
    vTex = texCoord;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform sampler2D diffuseMap;
uniform sampler2D specularMap;
uniform sampler2D normalMap;
uniform vec3 lightPos;       // вже помножена на ModelView на CPU

varying vec3 vPos;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTex;

void main() {
    // Gram-Schmidt з пріоритетом тангенса:
    // T не змінюється, з N віднімаємо його проєкцію на T
    vec3 T = normalize(vTangent);
    vec3 N = normalize(vNormal);
    N = normalize(N - dot(N, T) * T);
    vec3 B = cross(N, T);
    mat3 TBN = mat3(T, B, N);

    // Нормаль з текстури: [0;1] -> [-1;1], потім в систему ока
    vec3 nt = texture2D(normalMap, vTex).rgb * 2.0 - 1.0;
    vec3 Nm = normalize(TBN * nt);

    vec3 V = vec3(0.0, 0.0, 1.0);          // global viewer model
    if (dot(Nm, V) < 0.0) Nm = -Nm;        // двостороннє освітлення

    vec3 L = normalize(lightPos - vPos);
    vec3 R = reflect(-L, Nm);

    vec3 diffTex = texture2D(diffuseMap, vTex).rgb;
    vec3 specTex = texture2D(specularMap, vTex).rgb;

    vec3 ambient  = 0.2 * diffTex;
    vec3 diffuse  = max(dot(Nm, L), 0.0) * 0.8 * diffTex;           // diffuse * diffuse-текстура
    vec3 specular = pow(max(dot(R, V), 0.0), 40.0) * 0.6 * specTex; // specular * specular-текстура

    gl_FragColor = vec4(ambient + diffuse + specular, 1.0);
}`;